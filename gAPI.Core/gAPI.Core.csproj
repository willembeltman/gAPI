<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<InvariantGlobalization>true</InvariantGlobalization>

		<Version>0.0.2-beta</Version>
		<Authors>Willem Beltman</Authors>
		<Company>Willem Beltman</Company>
		<PackageId>gAPI.Core</PackageId>
		<Description>Shared contracts, attributes, identifiers, DTOs, serializers, and runtime helpers used by the gAPI source generators and analyzers.</Description>
		<PackageTags>gapi;dotnet;codegen;source-generator;analyzer;api;rpc;serialization;tooling</PackageTags>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<PackageProjectUrl>https://github.com/willembeltman/gAPI</PackageProjectUrl>
		<RepositoryUrl>https://github.com/willembeltman/gAPI</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<PackageReadmeFile>README.md</PackageReadmeFile>

		<!-- 1. Schakel symboolgeneratie in en kies voor embedded PDB's -->
		<PublishRepositoryUrl>true</PublishRepositoryUrl>
		<EmbedAllSources>true</EmbedAllSources>
		<IncludeSymbols>true</IncludeSymbols>
		<SymbolPackageFormat>snupkg</SymbolPackageFormat>

		<!-- 2. Zorg voor deterministische builds in CI-omgevingen -->
		<ContinuousIntegrationBuild Condition="'$(TF_BUILD)' == 'true' Or '$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>

		<GeneratePackageOnBuild>False</GeneratePackageOnBuild>
		<Title>gAPI Core</Title>
		<PackageReleaseNotes>Initial beta release of gAPI.Core.</PackageReleaseNotes>

		<!--<EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
		<CompilerGeneratedFilesOutputPath>Generated</CompilerGeneratedFilesOutputPath>-->

	</PropertyGroup>

	<!--<Target Name="ClearGeneratedFolder" BeforeTargets="BeforeBuild">
		<ItemGroup>
			<FolderToClean Include="$(ProjectDir)Generated\" />
		</ItemGroup>
		<RemoveDir Directories="@(FolderToClean)" />
		<MakeDir Directories="@(FolderToClean)" />
	</Target>
	
	<ItemGroup>
		<Compile Remove="$(CompilerGeneratedFilesOutputPath)/**/*.cs" />
	</ItemGroup>-->

	<ItemGroup>
		<ProjectReference Include="..\gAPI.AutoSerializer\gAPI.AutoSerializer.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
	</ItemGroup>
	
	<!--<ItemGroup>
		<PackageReference Include="gAPI.AutoSerializer" Version="0.0.2-beta">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
		</PackageReference>
	</ItemGroup>-->
	
	<ItemGroup>
		<PackageReference Include="Microsoft.AspNetCore.Http" Version="2.3.13" />
		<PackageReference Include="Microsoft.Extensions.DependencyModel" Version="10.0.12" />
		<PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.12" />
		<PackageReference Include="Microsoft.Extensions.Configuration" Version="10.0.12" />
		<PackageReference Include="System.ComponentModel.Annotations" Version="5.0.0" />
	</ItemGroup>

	<ItemGroup>
		<None Include="README.md" Pack="true" PackagePath="" />
	</ItemGroup>

</Project>
